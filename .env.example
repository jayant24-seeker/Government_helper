# Copy this file to .env and fill in real values before running.
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5003

# Set to 1 once you're serving over HTTPS (required for secure cookies)
COOKIE_SECURE=0

# Optional: SQLite is used by default. Set this to switch (e.g. Postgres on Render/Railway).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: enables AI-assisted complaint descriptions / image analysis.
# Leave unset and the app falls back to plain templated descriptions.
# GOOGLE_API_KEY=
